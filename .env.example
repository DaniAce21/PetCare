# Copiar a .env; generar una clave con scripts/configurar_local.py.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=petcare
DB_USER=petcare
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_TEST_NAME=test_petcare
# False permite HTTP en desarrollo/EC2 sin certificado. Activar solo al configurar TLS.
HTTPS_ENABLED=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# SMTP opcional (STARTTLS). Credenciales solo aquí, nunca en Git ni frontend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=petcare@example.invalid
# Activar solo detrás de Nginx local que reemplace X-Real-IP.
TRUSTED_PROXY_IPS=
# Mantener 0 hasta comprobar HTTPS, luego probar inicialmente 300.
HSTS_SECONDS=0
